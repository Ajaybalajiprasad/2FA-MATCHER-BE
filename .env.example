PORT=8000
# Use websocket for Neon when networks interrupt PostgreSQL traffic on port 5432.
# Requires Node.js 22+; leave tcp for ordinary/local PostgreSQL.
DATABASE_TRANSPORT=tcp
# Any PostgreSQL works (local, Neon, ...). Only this URL changes.
# Local: postgres://postgres:postgres@localhost:5432/travel_matcher
# Neon:  postgres://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel_matcher
# Path to the read-only data pack (relative to the project root)
DATA_DIR=hackathon-problem-3-group-travel-matcher/data
