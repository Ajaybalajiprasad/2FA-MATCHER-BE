{
  "name": "group-travel-matcher-be",
  "version": "1.0.0",
  "description": "Group Travel Matcher backend (Hackathon Problem 3)",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "nodemon",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
